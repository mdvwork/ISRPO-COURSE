    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(CourseValidation)' != 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(CourseValidation)' == 'true'">net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Update="data\projects.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

